# Copiar este archivo como .env y completar con los valores reales.
# El archivo .env NO se versiona (ver .gitignore).

# @BotFather en Telegram -> /newbot o /token
TELEGRAM_TOKEN=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cadena aleatoria que va en la URL del webhook, para que solo Telegram pueda
# llamarlo. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Supabase: Project Settings -> API Keys.
# SUPABASE_KEY tiene que ser la clave service_role (o sb_secret_...), NO la
# anon/publishable: la tabla tiene RLS activo y la clave pública no la ve.
# Equivale a acceso total a la base, así que va solo en el servidor.
SUPABASE_URL=
SUPABASE_KEY=

# DEJALA VACÍA. Quién puede usar el bot lo decide la tabla `usuarios_telegram`
# de Supabase, que además dice de QUIÉN es cada chat: una lista de chat_id acá
# sabe quién entra, pero no a nombre de quién guardar los movimientos.
#
# Para dar de alta a alguien, ver "Vincular un chat" en
# migrations/009_multiusuario.sql.
#
# Si le ponés chat_id, funciona como un cerrojo ADICIONAL: hay que estar en la
# tabla Y en esta lista. Sirve para una etapa de prueba; el costo es que sumar
# un usuario pasa a ser dos pasos y olvidarse del segundo se ve como un "no
# tengo tu acceso habilitado" que no se explica mirando la base.
CHATS_PERMITIDOS=

# SUPABASE_USER_ID ya no se usa: era el dueño único de todo lo que escribía el
# bot, y con varios usuarios ese dato sale de `usuarios_telegram` en cada
# mensaje. Se puede borrar del .env; si queda, se ignora.

# Desde qué dominios puede llamar la web al backend. Lista separada por coma,
# sin barra final. La web y el bot no comparten origen, así que sin esto el
# navegador bloquea el panel de Insights.
# Ejemplo: ORIGENES_WEB=https://tudominio.com,http://127.0.0.1:8777
ORIGENES_WEB=

# Protege los disparadores que llama un cron y no una persona: van en la URL,
# igual que WEBHOOK_SECRET. Sin él esos endpoints responden 404 y las tareas no
# corren solas. Son tres y comparten el secreto:
#   /tareas/alertas/<secreto>       revisa las alertas de precio
#   /tareas/recordatorios/<secreto> manda el recordatorio diario
#   /tareas/rendimientos/<secreto>  actualiza las TNA de las billeteras
# Generalo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# El mismo valor va en los Secrets del repo de GitHub, como ALERTAS_SECRET.
ALERTAS_SECRET=

# https://twelvedata.com -> Sign up -> API Key. El plan gratuito da 800
# llamadas por día y 8 por minuto.
#
# Va SOLO acá, del lado del servidor. Nunca en web/js/: todo lo que carga el
# navegador es público, y una clave en el front es una clave regalada. Para eso
# existe el proxy /api/precio.
#
# OPCIONAL: sin ella siguen andando los papeles argentinos (Data912 no pide
# clave) y el resto responde 503 explicando qué falta.
TWELVE_DATA_API_KEY=
