# Copiar este archivo como .env y completar con los valores reales.
# El archivo .env NO se versiona (ver .gitignore).

# @BotFather en Telegram -> /newbot o /token
TELEGRAM_TOKEN=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cadena aleatoria que va en la URL del webhook, para que solo Telegram pueda
# llamarlo. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Supabase: Project Settings -> API Keys.
# SUPABASE_KEY tiene que ser la clave service_role (o sb_secret_...), NO la
# anon/publishable: la tabla tiene RLS activo y la clave pública no la ve.
# Equivale a acceso total a la base, así que va solo en el servidor.
SUPABASE_URL=
SUPABASE_KEY=

# Quién puede usar el bot: chat_id de Telegram separados por coma.
# El username de un bot es público, así que sin esto cualquiera que lo
# encuentre puede cargar movimientos en tu misma tabla.
# Para saber tu chat_id: escribile al bot y miralo en el log del servidor
# ("Mensaje de <chat_id>: ..."), o preguntale a @userinfobot en Telegram.
CHATS_PERMITIDOS=

# UUID del usuario de Supabase dueño de los objetivos y las inversiones que
# registra el bot. Las dos tablas tienen user_id not null y su default
# auth.uid() NO se completa con service_role, así que el bot tiene que mandarlo
# explícito.
# Sacalo de Supabase -> Authentication -> Users -> tu usuario -> UID, o con:
#   select id, email from auth.users;
#
# OPCIONAL: sin esto el bot lee objetivos e imputa ahorros igual; solo se
# rechazan los objetivos nuevos y las compras de inversión.
SUPABASE_USER_ID=

# Desde qué dominios puede llamar la web al backend. Lista separada por coma,
# sin barra final. La web y el bot no comparten origen, así que sin esto el
# navegador bloquea el panel de Insights.
# Ejemplo: ORIGENES_WEB=https://tudominio.com,http://127.0.0.1:8777
ORIGENES_WEB=

# Protege el disparador de las alertas de precio, que llama un cron y no una
# persona: va en la URL, igual que WEBHOOK_SECRET. Sin él el endpoint responde
# 404 y las alertas no se revisan solas.
# Generalo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# El mismo valor va en los Secrets del repo de GitHub, como ALERTAS_SECRET.
ALERTAS_SECRET=

# https://twelvedata.com -> Sign up -> API Key. El plan gratuito da 800
# llamadas por día y 8 por minuto.
#
# Va SOLO acá, del lado del servidor. Nunca en web/js/: todo lo que carga el
# navegador es público, y una clave en el front es una clave regalada. Para eso
# existe el proxy /api/precio.
#
# OPCIONAL: sin ella siguen andando los papeles argentinos (Data912 no pide
# clave) y el resto responde 503 explicando qué falta.
TWELVE_DATA_API_KEY=
