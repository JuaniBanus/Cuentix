# Copiar este archivo como .env y completar con los valores reales.
# El archivo .env NO se versiona (ver .gitignore).

# @BotFather en Telegram -> /newbot o /token
TELEGRAM_TOKEN=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cadena aleatoria que va en la URL del webhook, para que solo Telegram pueda
# llamarlo. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Supabase: Project Settings -> API Keys.
# SUPABASE_KEY tiene que ser la clave service_role (o sb_secret_...), NO la
# anon/publishable: la tabla tiene RLS activo y la clave pública no la ve.
# Equivale a acceso total a la base, así que va solo en el servidor.
SUPABASE_URL=
SUPABASE_KEY=

# Quién puede usar el bot: chat_id de Telegram separados por coma.
# El username de un bot es público, así que sin esto cualquiera que lo
# encuentre puede cargar movimientos en tu misma tabla.
# Para saber tu chat_id: escribile al bot y miralo en el log del servidor
# ("Mensaje de <chat_id>: ..."), o preguntale a @userinfobot en Telegram.
CHATS_PERMITIDOS=

# UUID del usuario de Supabase dueño de los objetivos de ahorro.
# Panel de Supabase -> Authentication -> Users -> tu usuario -> UID.
#
# OPCIONAL: sin esto el bot lee objetivos e imputa ahorros igual, pero no puede
# crear objetivos nuevos (la columna user_id es NOT NULL y su default
# auth.uid() vale null cuando se escribe con la clave service_role).
SUPABASE_USER_ID=00000000-0000-0000-0000-000000000000
