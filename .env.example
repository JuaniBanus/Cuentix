# Copiar este archivo como .env y completar con los valores reales.
# El archivo .env NO se versiona (ver .gitignore).

# @BotFather en Telegram -> /newbot o /token
TELEGRAM_TOKEN=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cadena aleatoria que va en la URL del webhook, para que solo Telegram pueda
# llamarlo. Generala con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Supabase: Project Settings -> API Keys.
# SUPABASE_KEY tiene que ser la clave service_role (o sb_secret_...), NO la
# anon/publishable: la tabla tiene RLS activo y la clave pública no la ve.
# Equivale a acceso total a la base, así que va solo en el servidor.
SUPABASE_URL=
SUPABASE_KEY=
