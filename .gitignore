# Entornos virtuales
venv/
.venv/
env/

# Restos de un venv que quedó ilegible por corrupción de NTFS en el disco E:.
# Git tampoco lo puede leer, así que sin esto ensucia `git status` y puede
# hacer fallar comandos que recorren el árbol.
#
# Se borra solo después de correr, como administrador:  chkdsk E: /f
# Una vez que ande, esta línea se puede sacar.
.venv_danado/

# Variables de entorno
.env
.env.*
!.env.example

# Bases de datos locales
*.db
*.sqlite
*.sqlite3

# Bytecode / cache de Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Empaquetado / distribución
build/
dist/
*.egg-info/
.eggs/

# Testing y herramientas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Binarios de terceros (cloudflared para el túnel de desarrollo).
#
# Va `tools/*` y no `tools/`: si se excluye el DIRECTORIO, git ya no mira lo
# que hay adentro y las excepciones de abajo no tienen efecto. Excluyendo el
# contenido, sí se pueden re-incluir los scripts propios, que tienen que estar
# en el repo —sin el generador, los íconos de la PWA no se podrían rehacer.
tools/*
!tools/*.mjs
!tools/*.py

# Editores / sistema operativo
.vscode/
.idea/
Thumbs.db
desktop.ini

# Permisos de Claude Code: son de esta máquina, no del proyecto.
# Las skills de .claude/skills/ sí se versionan: son parte del repo.
.claude/settings.local.json
